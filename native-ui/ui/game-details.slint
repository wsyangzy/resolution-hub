import { Theme } from "theme.slint";
import { GameIcon, HubButton, VScroll } from "components.slint";
import { SessionSummary } from "panels.slint";

export struct DetailEntry { label: string, value: string }

export component GameDetails inherits Rectangle {
    in property <bool> active;
    in property <bool> has-profile;
    in property <string> name;
    in property <string> initial;
    in property <image> icon;
    in property <int> icon-id;
    in property <string> mode;
    in property <string> source;
    in property <[DetailEntry]> entries;
    in property <string> status-title;
    in property <string> status-message;
    in property <string> status-phase;
    in property <bool> status-error;
    in property <color> status-tint;
    in property <bool> session-active;
    in property <string> display;
    in property <bool> recovery-visible;
    in property <string> recovery-message;
    in property <bool> browse-enabled;
    in property <bool> restore-visible;
    in property <bool> restore-enabled;
    in property <string> restore-label;
    out property <length> content-height: 92px + content.min-height + (root.restore-visible ? 52px : 0px);
    callback close-requested;
    callback icon-requested(int);
    callback refreshed;
    callback restored;
    background: Theme.surface;
    public function focus-close() { close-button.focus-without-highlight(); }
    changed active => { if root.active { scroll.offset-y = 0px; } }
    FocusScope {
        enabled: root.active;
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-requested(); return accept; }
            if event.text == Key.DownArrow { scroll.offset-y = max(-max(0px, content.min-height - scroll.height), scroll.offset-y - 36px); return accept; }
            if event.text == Key.UpArrow { scroll.offset-y = min(0px, scroll.offset-y + 36px); return accept; }
            return reject;
        }
        VerticalLayout {
            x: 0px; y: 0px; width: parent.width; height: parent.height; spacing: 0px;
            Rectangle {
                height: 68px;
                HorizontalLayout {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    padding-left: 16px; padding-right: 12px; spacing: 12px;
                    cross-axis-alignment: center;
                    if root.has-profile: GameIcon {
                        width: 36px; height: 36px; source: root.icon; icon-id: root.active ? root.icon-id : 0; initial: root.initial;
                        requested(id) => { root.icon-requested(id); }
                    }
                    VerticalLayout {
                        height: 40px; spacing: 4px; horizontal-stretch: 1;
                        Text { text: root.has-profile ? root.name : "会话与桌面"; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                        Text { text: root.has-profile ? root.mode + "  ·  " + root.source : "添加游戏后，可在这里查看配置与会话"; color: Theme.secondary; font-size: 11px; overflow: elide; }
                    }
                    HubButton {
                        icon: "refresh"; compact: true; flat: true; label: "刷新游戏与桌面状态";
                        enabled: root.active && root.browse-enabled; clicked => { root.refreshed(); }
                    }
                    close-button := HubButton {
                        icon: "close"; compact: true; flat: true; label: "收起游戏与会话详情";
                        enabled: root.active; clicked => { root.close-requested(); }
                    }
                }
                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
            }
            Rectangle {
                min-height: 0px; vertical-stretch: 1;
                scroll := VScroll {
                    x: 16px; y: 12px; width: parent.width - 32px; height: max(0px, parent.height - 24px);
                    enabled: root.active; content-height: content.min-height;
                    content := VerticalLayout {
                        x: 0px; y: 0px; width: scroll.content-width; height: self.min-height; spacing: 12px;
                        SessionSummary {
                            title: root.status-title; message: root.status-message; phase: root.status-phase;
                            error: root.status-error; tint: root.status-tint;
                            recovery-visible: root.recovery-visible; recovery-message: root.recovery-message;
                            session-active: root.session-active; display: root.display;
                        }
                        if root.has-profile: Rectangle { height: 1px; background: Theme.border; }
                        if root.has-profile: VerticalLayout {
                            spacing: 0px;
                            for entry in root.entries: HorizontalLayout {
                                padding-top: 6px; padding-bottom: 6px; spacing: 12px;
                                Text { width: 96px; text: entry.label; color: Theme.muted; font-size: 11px; vertical-alignment: top; }
                                Text { text: entry.value; color: Theme.text; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
            if root.restore-visible: Rectangle {
                height: 52px; background: Theme.canvas;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    x: 16px; y: 8px; width: parent.width - 32px; height: 36px; spacing: 12px;
                    cross-axis-alignment: center;
                    Text { text: "保留游戏进程，恢复桌面显示"; color: Theme.muted; font-size: 11px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    HubButton {
                        text: root.restore-label; icon: root.session-active ? "stop" : "restore"; primary: true; tone: Theme.warning;
                        enabled: root.active && root.restore-enabled; clicked => { root.restored(); }
                    }
                }
            }
        }
    }
}
