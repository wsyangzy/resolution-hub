import { Motion, Theme } from "theme.slint";

export component Glyph inherits Image {
    in property <string> name: "monitor";
    in property <color> color: Theme.secondary;
    width: 18px;
    height: 18px;
    image-fit: contain;
    colorize: root.color;
    accessible-role: none;
    source: root.name == "play" ? @image-url("icons/play.svg")
        : root.name == "plus" ? @image-url("icons/plus.svg")
        : root.name == "chevron-down" ? @image-url("icons/chevron-down.svg")
        : root.name == "chevron-up" ? @image-url("icons/chevron-up.svg")
        : root.name == "stop" ? @image-url("icons/stop.svg")
        : root.name == "refresh" ? @image-url("icons/refresh.svg")
        : root.name == "close" ? @image-url("icons/close.svg")
        : root.name == "minimize" ? @image-url("icons/minimize.svg")
        : root.name == "maximize" ? @image-url("icons/maximize.svg")
        : root.name == "restore" ? @image-url("icons/restore.svg")
        : root.name == "shield" ? @image-url("icons/shield.svg")
        : root.name == "alert" ? @image-url("icons/alert.svg")
        : root.name == "activity" ? @image-url("icons/activity.svg")
        : root.name == "info" ? @image-url("icons/info.svg")
        : root.name == "layout" ? @image-url("icons/layout.svg")
        : root.name == "toolbar" ? @image-url("icons/toolbar.svg")
        : root.name == "window" ? @image-url("icons/window.svg")
        : root.name == "check" ? @image-url("icons/check.svg")
        : @image-url("icons/monitor.svg");
}

export component GameIcon inherits Rectangle {
    in property <image> source;
    in property <int> icon-id;
    in property <string> initial: "游";
    in property <bool> selected;
    callback requested(int);
    width: 32px; height: 32px;
    border-radius: 8px;
    background: root.source.width > 0 ? transparent : root.selected ? Theme.surface : Theme.avatar;
    init => { if root.icon-id > 0 { root.requested(root.icon-id); } }
    changed icon-id => { if root.icon-id > 0 { root.requested(root.icon-id); } }
    if root.source.width > 0: Image {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        source: root.source; image-fit: contain;
    }
    if root.source.width == 0: Text {
        text: root.initial; color: root.selected ? Theme.accent : Theme.secondary;
        font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center;
    }
}

// 布局分配整行高度，图形在独立容器中居中，不依赖布局的默认坐标。
export component IconSlot inherits Rectangle {
    in property <string> name;
    in property <color> tint: Theme.secondary;
    in property <length> size: 18px;
    width: root.size;
    min-height: root.size;
    Glyph {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        name: root.name;
        color: root.tint;
    }
}

// 与 Fluent Button 一样保持固定命中区域，统一处理鼠标与键盘状态。
// Tab 导航才显示焦点描边；打开面板时的程序设焦不再绘制外扩蓝框。
export component ActionArea inherits Rectangle {
    in property <bool> enabled: true;
    out property <bool> has-focus: keys.has-focus;
    out property <bool> focus-visible: root.enabled && keys.has-focus && root.keyboard-focus;
    out property <bool> hovered: root.enabled && touch.has-hover;
    out property <bool> pressed: root.enabled && ((touch.pressed && touch.has-hover) || root.key-down);
    callback activated;
    callback navigation-key(KeyEvent) -> EventResult;
    private property <bool> keyboard-focus;
    private property <bool> key-down;
    forward-focus: keys;
    min-width: 0px; min-height: 0px;
    accessible-role: none;
    navigation-key(event) => { return reject; }
    changed enabled => {
        if !root.enabled { root.key-down = false; root.keyboard-focus = false; }
    }
    public function focus-from-keyboard() {
        keys.focus();
        root.keyboard-focus = true;
    }
    public function focus-without-highlight() {
        keys.focus();
        root.keyboard-focus = false;
    }
    touch := TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.keyboard-focus = false;
                root.key-down = false;
                keys.focus();
            }
        }
        clicked => { if root.enabled { root.activated(); } }
    }
    keys := FocusScope {
        // 焦点层不参与鼠标命中，第一次点击直接交给 TouchArea。
        x: 0px; y: 0px; width: 0px; height: 0px;
        enabled: root.enabled;
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.key-down = false; root.keyboard-focus = false; }
        key-pressed(event) => {
            root.keyboard-focus = true;
            if event.text == " " || event.text == "\n" {
                root.key-down = true;
                return accept;
            }
            return root.navigation-key(event);
        }
        key-released(event) => {
            if event.text == " " || event.text == "\n" {
                if root.key-down && root.enabled {
                    root.key-down = false;
                    root.activated();
                }
                return accept;
            }
            return reject;
        }
    }
}

// 只有一条位于控件内部的焦点描边，不改变尺寸，也不会被窗口边缘裁切。
export component FocusRing inherits Rectangle {
    in property <bool> active;
    in property <bool> on-accent;
    in property <length> radius: Theme.control-radius;
    visible: root.active;
    accessible-role: none;
    Rectangle {
        x: root.on-accent ? 2px : 0px;
        y: root.on-accent ? 2px : 0px;
        width: max(0px, parent.width - 2 * self.x);
        height: max(0px, parent.height - 2 * self.y);
        border-radius: max(0px, root.radius - self.x);
        border-width: 2px;
        border-color: root.on-accent ? Theme.accent-ink : Theme.accent;
    }
}

export component HubButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> flat;
    in property <bool> danger;
    in property <bool> compact;
    in property <bool> fill-width;
    in property <bool> selected;
    in property <color> tone: Theme.accent;
    out property <bool> has-focus: action.has-focus;
    callback clicked;
    private property <bool> pressed: action.pressed;
    private property <bool> hovered: action.hovered;
    private property <color> foreground: !root.enabled ? Theme.disabled-text
        : root.primary || (root.danger && root.hovered) ? Theme.accent-ink
        : root.selected ? Theme.accent : root.text == "" ? Theme.secondary : Theme.text;
    private property <length> content-width: (root.text == "" ? 0px : caption.preferred-width)
        + (root.icon == "" ? 0px : 16px) + (root.icon != "" && root.text != "" ? 8px : 0px);
    private property <length> natural-width: root.text == "" ? root.height : root.content-width + 24px;
    private property <length> press-inset: root.pressed ? 1px : 0px;

    height: root.compact ? Theme.compact-control-height : Theme.control-height;
    min-width: root.visible ? root.natural-width : 0px;
    preferred-width: root.natural-width;
    max-width: root.fill-width ? 100000px : root.natural-width;
    horizontal-stretch: root.fill-width ? 1 : 0;
    vertical-stretch: 0;
    forward-focus: action;
    accessible-role: button;
    accessible-label: root.label == "" ? root.text : root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    animate press-inset { duration: Motion.press; easing: Motion.ease; }
    public function focus-from-keyboard() { action.focus-from-keyboard(); }
    public function focus-without-highlight() { action.focus-without-highlight(); }

    // 只缩进视觉层，点击区域与布局尺寸保持稳定。
    Rectangle {
        x: root.press-inset;
        y: root.press-inset;
        width: parent.width - 2 * root.press-inset;
        height: parent.height - 2 * root.press-inset;
        border-radius: Theme.control-radius;
        border-width: 1px;
        border-color: !root.enabled ? (root.flat ? transparent : Theme.border)
            : root.primary || root.flat ? transparent
            : root.hovered ? Theme.border-strong : Theme.border;
        background: !root.enabled ? (root.flat ? transparent : Theme.disabled-surface)
            : root.danger && root.hovered ? (root.pressed ? Theme.error.darker(10%) : Theme.error)
            : root.primary ? (root.pressed ? root.tone.darker(12%) : root.hovered ? root.tone.brighter(8%) : root.tone)
            : root.selected ? (root.pressed ? Theme.selection-pressed : Theme.accent-soft)
            : root.pressed ? Theme.border : root.hovered ? Theme.raised
            : root.flat ? transparent : Theme.surface;
        animate background, border-color { duration: Motion.feedback; easing: Motion.ease; }

        // 纯图标按钮直接按视觉层居中，空文字的字体度量不参与位置计算。
        Glyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 16px; height: 16px;
            visible: root.text == "" && root.icon != "";
            name: root.icon; color: root.foreground;
            animate colorize { duration: Motion.feedback; }
        }
        HorizontalLayout {
            visible: root.text != "";
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.content-width;
            height: 20px;
            spacing: root.icon != "" && root.text != "" ? 8px : 0px;
            cross-axis-alignment: center;
            Glyph {
                width: root.icon == "" ? 0px : 16px;
                height: 16px;
                visible: root.icon != "";
                name: root.icon;
                color: root.foreground;
                animate colorize { duration: Motion.feedback; }
            }
            caption := Text {
                width: self.preferred-width;
                height: 20px;
                text: root.text;
                color: root.foreground;
                font-size: 13px;
                font-weight: root.primary ? 600 : 500;
                vertical-alignment: center;
                accessible-role: none;
                animate color { duration: Motion.feedback; }
            }
        }
        FocusRing {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            active: action.focus-visible;
            on-accent: root.primary || (root.danger && root.hovered);
        }
    }
    action := ActionArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        enabled: root.enabled;
        activated => { root.clicked(); }
    }
}

// 所有面板头部使用布局分配宽度，避免无坐标的 Rectangle 自动居中或按钮铺满父项。
export component PanelHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> enabled: true;
    in property <bool> close-visible: true;
    in property <bool> add-visible;
    in property <bool> add-enabled: true;
    in property <bool> refresh-visible;
    in property <bool> refresh-enabled: true;
    callback closed;
    callback added;
    callback refreshed;
    height: root.subtitle == "" ? 48px : 60px;
    public function focus-close() { close-button.focus-without-highlight(); }
    public function focus-add() { add-button.focus-without-highlight(); }
    HorizontalLayout {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        padding-left: 16px; padding-right: 12px; spacing: 6px;
        cross-axis-alignment: center;
        VerticalLayout {
            height: root.subtitle == "" ? 20px : 38px;
            spacing: 3px; horizontal-stretch: 1;
            Text { height: 20px; text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; vertical-alignment: center; }
            if root.subtitle != "": Text { height: 15px; text: root.subtitle; color: Theme.muted; font-size: 11px; overflow: elide; vertical-alignment: center; }
        }
        add-button := HubButton {
            visible: root.add-visible; text: "添加"; icon: "plus"; compact: true; flat: true;
            width: root.add-visible ? self.preferred-width : 0px;
            enabled: root.enabled && root.add-visible && root.add-enabled;
            clicked => { root.added(); }
        }
        HubButton {
            visible: root.refresh-visible; icon: "refresh"; compact: true; flat: true; label: "刷新";
            width: root.refresh-visible ? 32px : 0px;
            enabled: root.enabled && root.refresh-visible && root.refresh-enabled;
            clicked => { root.refreshed(); }
        }
        close-button := HubButton {
            visible: root.close-visible; icon: "close"; compact: true; flat: true; label: "收起" + root.title;
            width: root.close-visible ? 32px : 0px;
            enabled: root.enabled && root.close-visible;
            clicked => { root.closed(); }
        }
    }
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
}

export component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.success;
    height: 28px;
    min-width: caption.preferred-width + 32px;
    preferred-width: caption.preferred-width + 32px;
    max-width: caption.preferred-width + 32px;
    horizontal-stretch: 0;
    border-radius: 14px;
    background: root.tint.with-alpha(0.07);
    border-width: 1px;
    border-color: root.tint.with-alpha(0.14);
    animate background, border-color { duration: Motion.feedback; }
    Rectangle {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 5px;
        height: 5px;
        border-radius: 3px;
        background: root.tint;
        animate background { duration: Motion.feedback; }
    }
    caption := Text {
        x: 22px;
        y: 0px;
        width: self.preferred-width;
        height: parent.height;
        text: root.text;
        color: root.tint;
        font-size: 11px;
        vertical-alignment: center;
        animate color { duration: Motion.feedback; }
    }
}

// 内容保留原生滚轮语义，轨道和滑块由应用绘制。
export component VScroll inherits Rectangle {
    in-out property <length> content-height;
    in property <bool> enabled: true;
    in-out property <length> offset-y <=> viewport.viewport-y;
    in-out property <length> content-width <=> viewport.viewport-width;
    private property <length> maximum: max(0px, root.content-height - root.height);
    min-height: 0px;
    clip: true;

    public function reveal(y: length, item-height: length) {
        if y + root.offset-y < 0px { root.offset-y = -y; }
        if y + item-height + root.offset-y > root.height {
            root.offset-y = root.height - y - item-height;
        }
        root.offset-y = max(-root.maximum, min(0px, root.offset-y));
    }
    changed content-height => { root.offset-y = max(-root.maximum, min(0px, root.offset-y)); }
    changed height => { root.offset-y = max(-root.maximum, min(0px, root.offset-y)); }

    viewport := Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        interactive: root.enabled;
        // 固定预留轨道，避免滚动条出现后改变换行高度形成布局循环。
        viewport-width: max(0px, root.width - 12px);
        viewport-height: max(root.height, root.content-height);
        @children
    }
    if root.maximum > 0px: Rectangle {
        x: parent.width - 10px;
        y: 0px;
        width: 10px;
        height: parent.height;
        thumb := Rectangle {
            x: (parent.width - self.width) / 2;
            width: drag.has-hover || drag.pressed ? 6px : 4px;
            height: min(parent.height, max(24px, parent.height * root.height / root.content-height));
            y: -root.offset-y / root.maximum * (parent.height - self.height);
            border-radius: 3px;
            background: drag.pressed ? Theme.muted : drag.has-hover ? Theme.disabled-text : Theme.border-strong;
            animate background, width { duration: Motion.feedback; easing: Motion.ease; }
        }
        drag := TouchArea {
            enabled: root.enabled;
            property <length> start-y;
            property <length> start-offset;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    if self.mouse-y < thumb.y || self.mouse-y > thumb.y + thumb.height {
                        root.offset-y = -root.maximum * max(0px, min(parent.height - thumb.height, self.mouse-y - thumb.height / 2)) / max(1px, parent.height - thumb.height);
                    }
                    self.start-y = self.mouse-y;
                    self.start-offset = root.offset-y;
                }
            }
            moved => {
                if self.pressed {
                    root.offset-y = max(-root.maximum, min(0px, self.start-offset - (self.mouse-y - self.start-y) * root.maximum / max(1px, parent.height - thumb.height)));
                }
            }
        }
    }
}

export struct GameEntry {
    id: string,
    name: string,
    resolution: string,
    refresh: string,
    initial: string,
    icon-id: int,
    icon: image,
}

export component GameSelector inherits Rectangle {
    in property <[GameEntry]> entries;
    in property <int> selected-index: -1;
    in property <bool> active: true;
    in property <bool> enabled: true;
    in property <bool> details-enabled: true;
    callback selected(int);
    callback activated(int);
    callback details-requested(int);
    callback icon-requested(int);
    private property <int> visible-rows: root.active ? min(root.entries.length, ceil(scroll.height / 52px) + 2) : 0;
    private property <int> first-row: max(0, min(root.entries.length - root.visible-rows, floor(-scroll.offset-y / 52px)));
    forward-focus: list-keys;
    accessible-role: list;
    accessible-label: "游戏列表，上下方向键选择，Enter 确认";
    min-height: 0px;
    background: Theme.surface;
    public function focus-list() {
        list-keys.focus();
        if root.selected-index >= 0 { scroll.reveal(root.selected-index * 52px, 52px); }
    }
    changed selected-index => { if root.selected-index >= 0 { scroll.reveal(root.selected-index * 52px, 52px); } }
    list-keys := FocusScope {
        enabled: root.active && (root.enabled || root.details-enabled) && root.entries.length > 0;
        key-pressed(event) => {
            if !root.enabled { return reject; }
            if event.text == "\n" && root.selected-index >= 0 { root.activated(root.selected-index); return accept; }
            if event.text == Key.UpArrow { root.selected(max(0, root.selected-index - 1)); return accept; }
            if event.text == Key.DownArrow { root.selected(min(root.entries.length - 1, root.selected-index + 1)); return accept; }
            if event.text == Key.Home { root.selected(0); return accept; }
            if event.text == Key.End { root.selected(root.entries.length - 1); return accept; }
            return reject;
        }
        scroll := VScroll {
            enabled: root.active && (root.enabled || root.details-enabled);
            content-height: root.entries.length * 52px;
            // 只为可视区域和两行缓冲创建控件，滚动时复用；图标也在进入可视区域后请求。
            for slot in root.visible-rows: row := Rectangle {
                property <int> index: root.first-row + slot;
                property <GameEntry> entry: root.entries[self.index];
                property <bool> chosen: root.selected-index == self.index;
                property <length> press-inset: root.enabled && item-touch.pressed ? 1px : 0px;
                x: 0px; y: self.index * 52px; width: scroll.content-width; height: 52px;
                animate press-inset { duration: Motion.press; easing: Motion.ease; }
                accessible-role: button;
                accessible-label: self.entry.name + "，" + self.entry.resolution + "，" + self.entry.refresh + (self.chosen ? "，已选择" : "");
                accessible-enabled: root.enabled;
                accessible-action-default => { if root.enabled { root.activated(self.index); } }
                Rectangle {
                    x: row.press-inset; y: 2px + row.press-inset;
                    width: parent.width - 2 * row.press-inset; height: parent.height - 4px - 2 * row.press-inset;
                    border-radius: 8px; border-width: 1px;
                    border-color: row.chosen ? (list-keys.has-focus ? Theme.accent : Theme.accent-border) : transparent;
                    background: root.enabled && item-touch.pressed ? Theme.selection-pressed
                        : row.chosen ? Theme.accent-soft
                        : root.enabled && item-touch.has-hover ? Theme.canvas : transparent;
                    animate background, border-color { duration: Motion.feedback; easing: Motion.ease; }
                    GameIcon {
                        x: 10px; y: (parent.height - self.height) / 2;
                        source: row.entry.icon; icon-id: row.entry.icon-id; initial: row.entry.initial; selected: row.chosen;
                        requested(id) => { root.icon-requested(id); }
                    }
                    Text {
                        x: 54px; y: 6px; width: max(0px, parent.width - 102px); height: 18px;
                        text: row.entry.name; color: Theme.text; font-size: 12px; font-weight: 600;
                        overflow: elide; vertical-alignment: center;
                    }
                    Text {
                        x: 54px; y: 26px; width: max(0px, parent.width - 102px); height: 16px;
                        text: row.entry.resolution + "  ·  " + row.entry.refresh;
                        color: Theme.secondary; font-size: 11px; font-family: Theme.display-font;
                        overflow: elide; vertical-alignment: center;
                    }
                }
                item-touch := TouchArea {
                    enabled: root.enabled; mouse-cursor: pointer;
                    clicked => { list-keys.focus(); root.activated(row.index); }
                }
                HubButton {
                    x: parent.width - 40px; y: (parent.height - self.height) / 2; width: 32px;
                    icon: "info"; compact: true; flat: true;
                    label: "查看 " + row.entry.name + " 的详细信息";
                    enabled: root.details-enabled && (root.enabled || row.chosen);
                    clicked => { root.details-requested(row.index); }
                }
            }
        }
    }
    if root.entries.length == 0: VerticalLayout {
        x: 16px; y: max(0px, (parent.height - 64px) / 2);
        width: parent.width - 32px; height: 64px;
        spacing: 6px; alignment: center;
        Text { text: "还没有游戏配置"; color: Theme.secondary; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
        Text { text: "点击“添加”选择启动来源与显示模式"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; }
    }
}
export component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 28px;
    HorizontalLayout {
        spacing: 14px;
        Text { text: root.label; width: 74px; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
        Text { text: root.value; color: Theme.secondary; font-size: 12px; overflow: elide; vertical-alignment: center; }
    }
}

export component SessionStep inherits Rectangle {
    in property <string> number;
    in property <string> text;
    in property <bool> active;
    height: 32px;
    min-width: caption.preferred-width + 32px;
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: root.active ? Theme.accent-soft : Theme.canvas;
        border-width: 1px;
        border-color: root.active ? Theme.accent-border : Theme.border;
        animate background, border-color { duration: Motion.feedback; }
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: root.number;
            color: root.active ? Theme.accent : Theme.muted;
            font-family: Theme.display-font;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: Motion.feedback; }
        }
    }
    caption := Text {
        x: 32px;
        y: 0px;
        width: parent.width - self.x;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.accent : Theme.muted;
        font-size: 11px;
        vertical-alignment: center;
        animate color { duration: Motion.feedback; }
    }
}

export component StepConnector inherits Rectangle {
    height: 32px;
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }
}

export component CloseConfirmation inherits Rectangle {
    in property <bool> active;
    in property <bool> embedded;
    in property <bool> ready;
    in property <string> message;
    in property <string> heading: "安全退出";
    in property <string> description: "先恢复桌面，再关闭窗口";
    in property <string> confirm-label: "确认退出";
    in property <string> cancel-label: "返回";
    callback confirmed;
    callback cancelled;
    callback dismissed;
    private property <float> progress: root.active ? 1 : 0;
    out property <bool> blocking: root.active || root.progress > 0;
    out property <length> content-height: 117px + message-content.min-height;
    visible: root.blocking;
    background: root.embedded ? Theme.surface : Theme.scrim;
    opacity: root.progress;
    animate progress { duration: root.active ? Motion.enter : Motion.exit; easing: Motion.ease; }
    changed blocking => { if !root.blocking { root.dismissed(); } }
    public function focus-cancel() { cancel-button.focus-without-highlight(); }

    // 退场动画完成前仍拦截背景，避免“返回”后的释放事件穿透到启动按钮。
    TouchArea { enabled: root.blocking; }
    FocusScope {
        enabled: root.blocking;
        key-pressed(event) => {
            if !root.active { return accept; }
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            if event.text == Key.DownArrow {
                message-scroll.offset-y = max(-max(0px, message-content.min-height - message-scroll.height), message-scroll.offset-y - 36px);
                return accept;
            }
            if event.text == Key.UpArrow { message-scroll.offset-y = min(0px, message-scroll.offset-y + 36px); return accept; }
            // 背景控件已禁用，Tab 只在弹窗的两个动作之间循环。
            if event.text == Key.Tab {
                if cancel-button.has-focus && root.ready { confirm-button.focus-from-keyboard(); }
                else { cancel-button.focus-from-keyboard(); }
                return accept;
            }
            return reject;
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.embedded ? 0px : (parent.height - self.height) / 2 + (1 - root.progress) * 8px;
            width: root.embedded ? parent.width : min(460px, parent.width - 48px);
            height: root.embedded ? parent.height : min(320px, parent.height - 48px);
            border-radius: root.embedded ? 10px : 16px;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: root.embedded ? 0px : 1px;
            drop-shadow-blur: root.embedded ? 0px : 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: root.embedded ? transparent : Theme.shadow;
            dialog-content := VerticalLayout {
                padding: root.embedded ? 22px : 26px;
                spacing: 18px;
                message-scroll := VScroll {
                    min-height: 0px; vertical-stretch: 1;
                    enabled: root.active;
                    content-height: message-content.min-height;
                    message-content := VerticalLayout {
                        x: 0px; y: 0px; width: message-scroll.content-width; height: self.min-height; spacing: 16px;
                        Rectangle {
                            height: 46px;
                            Rectangle {
                                x: 0px;
                                y: 3px;
                                width: 40px;
                                height: 40px;
                                border-radius: 12px;
                                background: Theme.warning-soft;
                                Glyph { x: 10px; y: 10px; width: 20px; height: 20px; name: "shield"; color: Theme.warning; }
                            }
                            VerticalLayout {
                                x: 54px;
                                y: 0px;
                                width: parent.width - self.x;
                                height: parent.height;
                                spacing: 4px;
                                Text { text: root.heading; font-size: 20px; font-weight: 600; color: Theme.text; }
                                Text { text: root.description; font-size: 12px; color: Theme.muted; }
                            }
                        }
                        Text { text: root.message; color: Theme.secondary; font-size: 13px; wrap: word-wrap; min-height: 58px; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Rectangle { horizontal-stretch: 1; }
                    cancel-button := HubButton { text: root.cancel-label; enabled: root.active; clicked => { root.cancelled(); } }
                    confirm-button := HubButton {
                        text: root.ready ? root.confirm-label : "请稍候…";
                        primary: true;
                        tone: Theme.warning;
                        enabled: root.active && root.ready;
                        clicked => { root.confirmed(); }
                    }
                }
            }
        }
    }
}
