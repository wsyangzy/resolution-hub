import { Motion, Theme } from "theme.slint";
import { ActionArea, FocusRing, Glyph, VScroll } from "components.slint";

export component HubTextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback focused;
    height: Theme.control-height;
    min-width: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : hover.has-hover ? Theme.border-strong : Theme.border;
    background: root.enabled ? Theme.surface : Theme.canvas;
    forward-focus: input;
    animate border-color { duration: Motion.feedback; }
    changed has-focus => { if root.has-focus { root.focused(); } }

    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    if root.text == "": Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.muted;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    input := TextInput {
        x: 12px;
        y: 6px;
        width: parent.width - 24px;
        height: 24px;
        text <=> root.text;
        enabled: root.enabled;
        font-size: 13px;
        color: root.enabled ? Theme.text : Theme.disabled-text;
        single-line: true;
        vertical-alignment: center;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.accent-ink;
        accessible-label: root.label;
        accessible-placeholder-text: root.placeholder;
        edited => { root.edited(self.text); }
    }
}

export component HubSelect inherits Rectangle {
    in property <[string]> options;
    in property <int> current-index: -1;
    in property <string> placeholder: "请选择";
    in property <string> label;
    in property <bool> enabled: true;
    private property <int> highlighted: -1;
    private property <bool> expanded;
    out property <bool> has-focus: action.has-focus || root.expanded;
    callback selected(int);
    callback focused;
    height: Theme.control-height;
    min-width: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: root.expanded ? Theme.accent-border : action.hovered ? Theme.border-strong : Theme.border;
    background: !root.enabled ? Theme.canvas : action.pressed ? Theme.raised : Theme.surface;
    forward-focus: action;
    animate background, border-color { duration: Motion.feedback; }
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-value: caption.text;
    accessible-action-expand => { root.open(); }
    changed enabled => { if !root.enabled { popup.close(); } }
    changed has-focus => { if root.has-focus { root.focused(); } }

    public function open() {
        if root.enabled && root.options.length > 0 {
            root.highlighted = max(0, root.current-index);
            popup.show();
        }
    }
    function choose(index: int, keyboard: bool) {
        if index >= 0 && index < root.options.length {
            popup.close();
            if keyboard { action.focus-from-keyboard(); }
            else { action.focus(); }
            root.selected(index);
        }
    }
    caption := Text {
        x: 12px;
        y: 0px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.current-index >= 0 && root.current-index < root.options.length
            ? root.options[root.current-index] : root.placeholder;
        color: !root.enabled ? Theme.disabled-text : root.current-index < 0 ? Theme.muted : Theme.text;
        font-size: 12px;
        overflow: elide;
        vertical-alignment: center;
        accessible-role: none;
    }
    Glyph {
        x: parent.width - 28px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        name: root.expanded ? "chevron-up" : "chevron-down";
        color: root.has-focus ? Theme.accent : Theme.muted;
    }
    FocusRing {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        active: action.focus-visible;
    }
    action := ActionArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        enabled: root.enabled && root.options.length > 0;
        activated => { root.open(); }
        navigation-key(event) => {
            if event.text == Key.DownArrow {
                root.selected(min(root.options.length - 1, root.current-index + 1));
                return accept;
            }
            if event.text == Key.UpArrow {
                root.selected(max(0, root.current-index - 1));
                return accept;
            }
            return reject;
        }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: min(6, root.options.length) * 34px + 8px;
        close-policy: close-on-click-outside;
        forward-focus: popup-keys;
        popup-keys := FocusScope {
            property <int> highlighted: root.highlighted;
            changed highlighted => { if self.highlighted >= 0 { options-scroll.reveal(self.highlighted * 34px, 34px); } }
            focus-changed-event => { root.expanded = self.has-focus; }
            key-pressed(event) => {
                if event.text == Key.Escape || event.text == Key.Tab {
                    popup.close();
                    action.focus-from-keyboard();
                    return event.text == Key.Escape ? accept : reject;
                }
                if event.text == Key.DownArrow { root.highlighted = min(root.options.length - 1, root.highlighted + 1); return accept; }
                if event.text == Key.UpArrow { root.highlighted = max(0, root.highlighted - 1); return accept; }
                if event.text == Key.Home { root.highlighted = 0; return accept; }
                if event.text == Key.End { root.highlighted = root.options.length - 1; return accept; }
                if event.text == "\n" || event.text == " " { root.choose(root.highlighted, true); return accept; }
                return reject;
            }
            Rectangle {
                border-radius: 9px;
                border-width: 1px;
                border-color: Theme.border-strong;
                background: Theme.surface;
                options-scroll := VScroll {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    content-height: root.options.length * 34px;
                    for option[index] in root.options: Rectangle {
                        x: 0px;
                        y: index * 34px;
                        width: options-scroll.content-width;
                        height: 34px;
                        border-radius: 5px;
                        accessible-role: button;
                        accessible-label: option + (root.current-index == index ? "，已选择" : "");
                        accessible-enabled: root.enabled;
                        accessible-action-default => { if root.enabled { root.choose(index, true); } }
                        background: option-touch.has-hover || root.highlighted == index ? Theme.accent-soft : transparent;
                        animate background { duration: Motion.feedback; }
                        Text {
                            x: 10px;
                            y: 0px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text: option;
                            font-size: 12px;
                            color: root.current-index == index ? Theme.accent : Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.choose(index, false); }
                        }
                    }
                }
            }
        }
    }
}
